---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <header class="container head" style="padding-bottom: var(--section-pad)">
    <p class="head__eyebrow eyebrow"><span>404</span></p>
    <h1 class="h2 head__title">This page is not in any issue.</h1>
    <div class="head__row">
      <p class="body-md muted">The link may be old, or the issue may not exist yet. Today's brief and the archive are one click away.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Read today's issue</a>
        <a class="btn btn--secondary" href="/archive/">Search the archive</a>
      </div>
    </div>
  </header>
</Base>
